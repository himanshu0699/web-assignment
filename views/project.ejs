<!DOCTYPE html>
<html lang="en" data-theme="dim">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= project.title %></title>
    <link href="/css/main.css" rel="stylesheet" />
  </head>

  <body>
    <%- include('partials/navbar') %>

    <div class="container mx-auto p-6">
      <!-- header -->
      <div class="text-center mb-10">
        <h1 class="text-4xl font-bold mb-2"><%= project.title %></h1>
        <p>Below, you will find detailed information about the project.</p>
      </div>

      <!-- card -->
      <div class="card bg-base-100 shadow-xl max-w-3xl mx-auto">
        <figure>
          <img
            src="<%= project.feature_img_url && project.feature_img_url.trim()
                     ? project.feature_img_url
                     : '/images/no-image.png' %>"
            alt="<%= project.title %>"
            class="object-cover w-full max-h-80"
          />
        </figure>

        <div class="card-body">
          <p class="mb-4"><%= project.intro_short %></p>

          <% if (project.impact) { %>
          <h3 class="font-semibold mb-2">Impact</h3>
          <p class="mb-4"><%= project.impact %></p>
          <% } %> <% if (project.original_source_url) { %>
          <a
            href="<%= project.original_source_url %>"
            target="_blank"
            class="btn btn-outline btn-primary mb-6"
            >Learn More</a
          >
          <% } %> <% if (session && session.user) { %>
          <div class="flex flex-col sm:flex-row gap-3 mb-6">
            <a
              href="/solutions/editProject/<%= project.id %>"
              class="btn btn-secondary w-full sm:w-auto"
              >Edit Project</a
            >

            <form
              action="/solutions/deleteProject/<%= project.id %>"
              method="post"
              class="w-full sm:w-auto"
              onsubmit="return confirm('Delete this project permanently?');"
            >
              <button class="btn btn-error w-full sm:w-auto">
                Delete Project
              </button>
            </form>
          </div>
          <% } %>

          <!-- Quote of the day -->
          <div class="bg-base-200 rounded-xl p-4 text-center">
            <h3 class="font-semibold mb-2">Quote of the Day</h3>
            <p id="quote" class="italic"></p>
            <p id="author" class="font-semibold mt-1"></p>
          </div>
        </div>
      </div>

      <div class="text-center mt-10">
        <a
          href="#"
          onclick="history.back();return false;"
          class="btn btn-secondary"
          >Go Back</a
        >
      </div>
    </div>

    <script>
      fetch("https://dummyjson.com/quotes/random")
        .then((r) => r.json())
        .then((q) => {
          document.getElementById("quote").textContent = `"${q.quote}"`;
          document.getElementById("author").textContent = `– ${q.author}`;
        })
        .catch(() => {
          document.getElementById("quote").textContent =
            "Unable to load quote.";
        });
    </script>
  </body>
</html>
