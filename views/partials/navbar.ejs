  <div class="flex-1">
    <a href="/" class="text-xl font-bold">Climate Solutions</a>
  </div>

  <div class="flex-none">
    <ul class="menu menu-horizontal px-1">
      <!-- Static link -->
      <li><a href="/about">About</a></li>

      <!-- Sector dropdown -->
